# Security Module Configuration
# Copy this file to .env and update values for your environment

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-here-min-32-characters-random
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# Rate Limiting Configuration
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Redis Configuration (Optional - untuk production dengan multiple instances)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
USE_REDIS_RATE_LIMITER=false

# Notes:
# - JWT_SECRET_KEY: WAJIB diganti di production! Generate dengan: openssl rand -hex 32
# - RATE_LIMIT_MAX_REQUESTS: Jumlah maksimal requests per window
# - RATE_LIMIT_WINDOW_SECONDS: Window time dalam detik
# - USE_REDIS_RATE_LIMITER: Set ke 'true' untuk menggunakan Redis (distributed rate limiting)
